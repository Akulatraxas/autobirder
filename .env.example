# Path to your photo folder (REQUIRED; files here are modified in place!)
PHOTOS_DIR=/path/to/photos

# Host port bound on 127.0.0.1
PORT=8000

# Host user/group ID so modified files keep your ownership (`id -u` / `id -g`).
# Set both to 0 only for special setups where your user cannot write (e.g. SMB in WSL).
PUID=1000
PGID=1000

# Comma-separated Host headers accepted by the app.
# Keep localhost,127.0.0.1 so the container healthcheck continues to pass.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: override the container image (e.g. a local build or specific version tag)
# AUTOBIRDER_IMAGE=ghcr.io/akulatraxas/autobirder:latest
